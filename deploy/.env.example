# Copy to .env and adjust. Used by docker-compose.

# --- database ---
POSTGRES_USER=vidhive
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vidhive

# --- agents ---
# Target URL template. Point it at the mock service for safe end-to-end runs:
#   TARGET_TEMPLATE=http://mock:8090/{id}
TARGET_TEMPLATE=http://kinescope.io/{id}

# Global checks per second per agent (politeness limit).
RATE_LIMIT_RPS=10

# Threads per agent. AGENT_THREADS sets every server at once (global);
# AGENT_0N_THREADS overrides a single server — individual wins over global.
# Defaults are 34/33/33 = 100 concurrent operations across the stand.
#AGENT_THREADS=20
#AGENT_01_THREADS=34
#AGENT_02_THREADS=33
#AGENT_03_THREADS=33

# --- mock target service ---
# Size of the fake video payload it serves for "found" identifiers.
MOCK_PAYLOAD_KB=256
