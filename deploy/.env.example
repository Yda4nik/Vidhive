# Copy to .env and adjust. Used by docker-compose.

# --- database ---
POSTGRES_USER=vidhive
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vidhive

# --- agents ---
# Target URL template. Point it at the mock service for safe end-to-end runs:
#   TARGET_TEMPLATE=http://mock:8090/{id}
TARGET_TEMPLATE=http://kinescope.io/{id}

# Global checks per second per agent (politeness limit).
RATE_LIMIT_RPS=10

# Threads per agent. AGENT_THREADS sets every server at once (global);
# AGENT_0N_THREADS overrides a single server — individual wins over global.
# Defaults are 34/33/33 = 100 concurrent operations across the stand.
#AGENT_THREADS=20
#AGENT_01_THREADS=34
#AGENT_02_THREADS=33
#AGENT_03_THREADS=33

# --- mock target service ---
# Size of the fake video payload it serves for "found" identifiers.
MOCK_PAYLOAD_KB=256

# --- access control (coordinator) ---
# Signs the login session cookie. Set to a long random string in production.
VIDHIVE_SECRET_KEY=change-me-to-a-long-random-string
# First administrator, created at startup only when no users exist yet.
VIDHIVE_ADMIN_USER=admin
VIDHIVE_ADMIN_PASSWORD=change-me
# Shared secret agents send to the coordinator's machine endpoints.
# Leave empty to disable the check (agents keep working, endpoints open).
# Set the SAME value here for the coordinator and all agents to close them.
VIDHIVE_AGENT_TOKEN=
